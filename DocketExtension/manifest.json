{
  "manifest_version": 3,
  "name": "Docket Extension",
  "description": "Lightweight helper panel for Google Calendar with AI backend hooks.",
  "version": "0.1.0",
  "action": {
    "default_title": "Docket",
    "default_popup": "src/popup.html"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "identity"
  ],
  "host_permissions": [
    "https://calendar.google.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://calendar.google.com/*"],
      "js": ["src/content.js"],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/styles.css"],
      "matches": ["https://calendar.google.com/*"]
    }
  ]
}
